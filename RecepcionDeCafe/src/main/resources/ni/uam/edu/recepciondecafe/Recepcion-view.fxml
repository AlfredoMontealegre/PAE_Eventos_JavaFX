<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.recepciondecafe.RecepcionController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="300.0" spacing="10.0" style="-fx-background-color: #064E3B;">
         <children>
            <Label text="Nombre del productor" textFill="#ecfdf5">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font></Label>
            <TextField fx:id="txtNombre" maxWidth="170.0" promptText="Claudio" style="-fx-background-color: #047857;">
               <font>
                  <Font name="System Bold Italic" size="13.0" />
               </font></TextField>
            <Label text="Codigo del lote" textFill="#ecfdf5">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font></Label>
            <TextField fx:id="txtCodigo" maxWidth="170.0" promptText="C1" style="-fx-background-color: #047857;">
               <font>
                  <Font name="System Bold Italic" size="13.0" />
               </font></TextField>
            <Label text="Peso en kilogramos" textFill="#ecfdf5">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font></Label>
            <TextField fx:id="txtPesoKG" maxWidth="170.0" promptText="12.4" style="-fx-background-color: #047857;">
               <font>
                  <Font name="System Bold Italic" size="13.0" />
               </font></TextField>
            <Label fx:id="lblMensajeError" textFill="RED">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#ButtonGuardar" style="-fx-background-color: #F59E0B;" text="Agregar">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#BtnactualizarLote" style="-fx-background-color: #F59E0B;" text="Actualizar">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="tablaLotes" prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: #D1FAE5;" styleClass="-fx-text-fill: black">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="100.0" style="-fx-background-color: #D1FAE5; -fx-text-fill: black;" styleClass="-fx-text-fill: black" text="Nombre" />
          <TableColumn fx:id="colCodigo" prefWidth="100.0" style="-fx-background-color: #D1FAE5; -fx-text-fill: black;" styleClass="-fx-text-fill: black" text="Codigo" />
            <TableColumn fx:id="colpesoKG" prefWidth="100.0" style="-fx-background-color: #D1FAE5; -fx-text-fill: black;" styleClass="-fx-text-fill: black" text="PesoKG" />
        </columns>
      </TableView>
   </children>
</HBox>
